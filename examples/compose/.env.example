# CUR 버킷에 읽기 권한을 가진 AWS 자격증명
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# AWS/CUR 식별 정보 — config.toml 대신 여기서 관리 (파일에 박지 않음)
CURHOUSE_AWS_REGION=us-east-1
CURHOUSE_AWS_ACCOUNT_ID=            # 12자리 AWS 계정 ID
CURHOUSE_CUR_BUCKET_NAME=           # 실제 CUR export 버킷 이름
# CURHOUSE_AWS_PROFILE=             # env 자격증명 쓰면 비워둠

# ClickHouse 접속. config.toml 의 [clickhouse] 값을 오버라이드.
# (secure 는 env 오버라이드 없으므로 SSL 필요 시 config.toml 에서 true 로.)
CURHOUSE_CH_HOST=host.docker.internal
CURHOUSE_CH_PORT=8123
CURHOUSE_CH_USER=default
CURHOUSE_CH_PASSWORD=

# state 파일 경로 (컨테이너 안 경로 — 볼륨 마운트 위치와 일치해야 함)
CURHOUSE_STATE_PATH=/state/state.json
