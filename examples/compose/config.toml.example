# 회사/계정 값은 파일에 박지 말고 .env 로 주입 권장:
#   CURHOUSE_AWS_PROFILE / CURHOUSE_AWS_REGION / CURHOUSE_AWS_ACCOUNT_ID /
#   CURHOUSE_CUR_BUCKET_NAME
# 아래 값들은 어차피 env 가 덮으므로 더미 placeholder 로 둔다.

[aws]
profile = ""                         # 컨테이너에선 env(.env) 로 자격증명 → 비워둠
region = "us-east-1"
account_id = "000000000000"          # 실제 값은 CURHOUSE_AWS_ACCOUNT_ID

[cur]
bucket_name = "your-cur-bucket"      # 실제 값은 CURHOUSE_CUR_BUCKET_NAME
time_granularity = "HOURLY"
include_resources = true
include_split_cost_allocation = true

# 계정별로 이 [[sources]] 블록을 반복. 같은 버킷의 다른 prefix 에 각 CUR 이 쌓이는 걸 전제.
[[sources]]
name = "dev"
prefix = "cur2"
export_name = "cur-export"

# [[sources]]
# name = "qa"
# prefix = "qa"
# export_name = "cur_to_dev"
#
# [[sources]]
# name = "prod"
# prefix = "prod"
# export_name = "cur_to_dev"

[clickhouse]
# host/port/user/password 는 env 로 오버라이드 가능 (.env 참고)
host = "localhost"
port = 8123
user = "default"
password = ""
database = "aws_billing"
table = "cur_line_items"
secure = false                        # 원격 SSL CH 라면 true 로 (env override 없음)

[state]
path = "/state/state.json"           # 컴포즈 볼륨 마운트 경로와 일치시켜야 재부팅 시 유지됨
