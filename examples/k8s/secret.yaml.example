# 실제 배포에선 이 파일을 그대로 커밋하지 말 것 — sealed-secrets / external-secrets /
# SOPS 같은 걸로 관리하는 게 정석. 여기선 참고용 최소 형태만 제공.
apiVersion: v1
kind: Secret
metadata:
  name: curhouse-secrets
  namespace: curhouse
type: Opaque
stringData:
  # CUR 버킷에 읽기 권한을 가진 AWS 자격증명
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  # ClickHouse 비밀번호
  CURHOUSE_CH_PASSWORD: ""
