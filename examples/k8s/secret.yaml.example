# 실제 배포에선 이 파일을 그대로 커밋하지 말 것 — sealed-secrets / external-secrets /
# SOPS 같은 걸로 관리하는 게 정석. 여기선 참고용 최소 형태만 제공.
apiVersion: v1
kind: Secret
metadata:
  name: curhouse-secrets
  namespace: curhouse
  labels:
    app.kubernetes.io/name: curhouse
    app.kubernetes.io/component: secrets
    app.kubernetes.io/part-of: curhouse
    app.kubernetes.io/managed-by: kubectl
type: Opaque
stringData:
  # CUR 버킷에 읽기 권한을 가진 AWS 자격증명
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  # AWS/CUR 식별 정보 — configmap 대신 여기서 env 로 주입 (파일에 박지 않음)
  CURHOUSE_AWS_REGION: "us-east-1"
  CURHOUSE_AWS_ACCOUNT_ID: ""           # 12자리 계정 ID
  CURHOUSE_CUR_BUCKET_NAME: ""          # 실제 버킷 이름
  # CURHOUSE_AWS_PROFILE: ""            # env 자격증명 쓰면 비워둠
  # ClickHouse 비밀번호
  CURHOUSE_CH_PASSWORD: ""
